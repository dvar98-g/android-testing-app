<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Suite completa del framework.

  Ejecucion secuencial (sin parallel) de forma deliberada: BaseTest abre una
  sesion de Appium por cada metodo de test contra un unico emulador, por lo que
  ejecutar en paralelo generaria conflictos de sesion sobre el mismo dispositivo.

  Cada modulo queda en su propio <test> para poder ejecutarlos de forma aislada
  cuando haga falta.
-->
<suite name="Android Native Demo App Suite" verbose="1">

    <test name="Menu">
        <classes>
            <class name="com.globant.mobile.tests.menu.MenuTest"/>
        </classes>
    </test>

    <test name="Login">
        <classes>
            <class name="com.globant.mobile.tests.login.SignUpTest"/>
            <class name="com.globant.mobile.tests.login.LoginTest"/>
        </classes>
    </test>

    <test name="Swipe">
        <classes>
            <class name="com.globant.mobile.tests.swipe.SwipeTest"/>
        </classes>
    </test>

</suite>